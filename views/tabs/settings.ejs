<% const btnPrimary = "inline-block rounded-lg bg-slate-100 px-4 py-2 text-sm font-medium text-indigo-950 hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-200";
   const btnGhost = "px-2 py-2 text-sm text-slate-400 hover:text-white";
   const input = "w-full rounded-lg border border-slate-600 bg-indigo-950/60 px-3 py-2 text-white focus:border-slate-300 focus:outline-none"; %>

<h1 class="text-center text-3xl font-semibold tracking-tight text-white sm:text-4xl">Settings</h1>

<% if (flash) { %>
  <p class="mt-6 rounded-lg border border-emerald-700 bg-emerald-900/30 px-4 py-3 text-sm text-emerald-200" role="status">
    <%= flash.text %>
  </p>
<% } %>

<div class="mt-8 divide-y divide-indigo-800 rounded-2xl border border-indigo-800 bg-indigo-950/30">

  <!-- Password -->
  <section class="p-5 sm:p-6">
    <h2 class="text-lg font-medium text-white">Password</h2>

    <% if (!passwordStep) { %>
      <div class="mt-1 flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm text-slate-400">The admin password used to sign in.</p>
        <a href="/settings/password" class="<%= btnPrimary %>">Change password</a>
      </div>

    <% } else if (passwordStep === "verify") { %>
      <p class="mt-1 text-sm text-slate-400">Enter your current password to continue.</p>
      <form action="/settings/password/verify" method="POST" class="mt-4 space-y-4">
        <div>
          <label for="currentPassword" class="mb-1 block text-sm text-slate-300">Current password</label>
          <input id="currentPassword" name="currentPassword" type="password" required autofocus autocomplete="current-password" class="<%= input %>">
        </div>
        <% if (passwordError) { %>
          <p class="text-sm text-rose-300" role="alert"><%= passwordError %></p>
        <% } %>
        <div class="flex items-center gap-3">
          <button type="submit" class="<%= btnPrimary %>">Continue</button>
          <a href="/settings" class="<%= btnGhost %>">Cancel</a>
        </div>
      </form>

    <% } else if (passwordStep === "new") { %>
      <p class="mt-1 text-sm text-slate-400">Choose a new password with at least 8 characters.</p>
      <form id="new-password-form" action="/settings/password" method="POST" class="mt-4 space-y-4">
        <div>
          <label for="newPassword" class="mb-1 block text-sm text-slate-300">New password</label>
          <input id="newPassword" name="newPassword" type="password" required minlength="8" autofocus autocomplete="new-password" class="<%= input %>">
        </div>
        <div>
          <label for="confirmPassword" class="mb-1 block text-sm text-slate-300">Confirm new password</label>
          <input id="confirmPassword" name="confirmPassword" type="password" required minlength="8" autocomplete="new-password" class="<%= input %>">
        </div>
        <p id="match-message" class="text-sm text-rose-300" role="alert"><%= passwordError || "" %></p>
        <div class="flex items-center gap-3">
          <button type="submit" class="<%= btnPrimary %>">Save new password</button>
          <a href="/settings" class="<%= btnGhost %>">Cancel</a>
        </div>
      </form>

      <script>
        const newPassword = document.getElementById("newPassword");
        const confirmPassword = document.getElementById("confirmPassword");
        const matchMessage = document.getElementById("match-message");

        function checkMatch() {
          const mismatch = confirmPassword.value !== "" && newPassword.value !== confirmPassword.value;
          confirmPassword.setCustomValidity(mismatch ? "The two passwords don't match." : "");
          matchMessage.textContent = mismatch ? "The two passwords don't match." : "";
        }

        newPassword.addEventListener("input", checkMatch);
        confirmPassword.addEventListener("input", checkMatch);
      </script>
    <% } %>
  </section>

  <!-- API key -->
  <section class="p-5 sm:p-6">
    <h2 class="text-lg font-medium text-white">twitterapi.io API key</h2>

    <% if (!editingKey) { %>
      <div class="mt-1 flex flex-wrap items-center justify-between gap-3">
        <p class="text-sm text-slate-400">
          <% if (maskedKey) { %>
            Current key: <span class="font-mono text-slate-300"><%= maskedKey %></span>
          <% } else { %>
            No key is set. Extractions won't run until you add one.
          <% } %>
        </p>
        <a href="/settings/api-key" class="<%= btnPrimary %>"><%= maskedKey ? "Change key" : "Add key" %></a>
      </div>
    <% } else { %>
      <p class="mt-1 text-sm text-slate-400">Paste the key from your twitterapi.io dashboard. It replaces the current one.</p>
      <form action="/settings/api-key" method="POST" class="mt-4 space-y-4" onsubmit="this.querySelector('button').disabled = true">
        <div>
          <label for="apiKey" class="mb-1 block text-sm text-slate-300">New API key</label>
          <input id="apiKey" name="apiKey" type="text" required autofocus autocomplete="off" spellcheck="false" class="<%= input %> font-mono text-sm">
        </div>
        <% if (keyError) { %>
          <p class="text-sm text-rose-300" role="alert"><%= keyError %></p>
        <% } %>
        <div class="flex items-center gap-3">
          <button type="submit" class="<%= btnPrimary %>">Save key</button>
          <a href="/settings" class="<%= btnGhost %>">Cancel</a>
        </div>
      </form>
    <% } %>
  </section>

  <!-- Reset data -->
  <section class="p-5 sm:p-6">
    <h2 class="text-lg font-medium text-white">Reset data</h2>
    <div class="mt-1 flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm text-slate-400">
        <%= extractionCount === 1 ? "1 extraction is" : `${extractionCount} extractions are` %> saved in History.
      </p>
      <button type="button" onclick="document.getElementById('reset-dialog').showModal()"
        <%= extractionCount === 0 && !runningId ? "disabled" : "" %>
        class="rounded-lg border border-rose-500 px-4 py-2 text-sm font-medium text-rose-200 hover:bg-rose-500/15 disabled:cursor-not-allowed disabled:opacity-40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rose-300">
        Reset data
      </button>
    </div>
  </section>
</div>

<dialog id="reset-dialog" aria-labelledby="reset-title"
  class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-indigo-700 bg-indigo-950 p-0 text-slate-200 backdrop:bg-black/60">
  <form action="/settings/reset" method="POST" class="p-6">
    <h2 id="reset-title" class="text-lg font-medium text-white">Delete all saved extractions?</h2>
    <p class="mt-2 text-sm text-slate-400">
      Every extraction and its wallet list will be removed from History. This can't be undone.
      <% if (runningId) { %>The extraction that's running now will be stopped too.<% } %>
    </p>
    <div class="mt-6 flex justify-end gap-3">
      <button type="button" onclick="document.getElementById('reset-dialog').close()" class="<%= btnGhost %>">Cancel</button>
      <button type="submit" class="rounded-lg bg-rose-500 px-4 py-2 text-sm font-medium text-white hover:bg-rose-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rose-300">
        Delete everything
      </button>
    </div>
  </form>
</dialog>