<h1 class="text-3xl font-semibold tracking-tight text-white">History</h1>

<% if (!extractions.length) { %>
  <p class="mt-4 text-slate-400">
    No extractions yet. <a href="/" class="text-slate-200 underline hover:text-white">Paste an X post link on the Home tab</a> to start one.
  </p>
<% } else { %>
  <div class="mt-8 overflow-x-auto">
    <table class="w-full min-w-[640px] text-left text-sm">
      <thead class="border-b border-indigo-800 text-slate-400">
        <tr>
          <th class="py-2 pr-4 font-normal">Post</th>
          <th class="py-2 pr-4 font-normal">Started</th>
          <th class="py-2 pr-4 font-normal">Status</th>
          <th class="py-2 pr-4 text-right font-normal">Replies checked</th>
          <th class="py-2 pr-4 text-right font-normal">Addresses</th>
          <th class="py-2"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-indigo-800/60">
        <% extractions.forEach((e) => { %>
          <tr>
            <td class="max-w-xs truncate py-3 pr-4 text-slate-200"><%= e.postUrl.replace(/^https?:\/\/(www\.)?/, "") %></td>
            <td class="py-3 pr-4 text-slate-400"><time datetime="<%= e.createdAt %>"><%= e.createdAt.slice(0, 16).replace("T", " ") %></time></td>
            <td class="py-3 pr-4"><%- include("../partials/status", { status: e.status }) %></td>
            <td class="py-3 pr-4 text-right tabular-nums"><%= e.repliesScanned %></td>
            <td class="py-3 pr-4 text-right tabular-nums"><%= e.resultCount %></td>
            <td class="py-3 text-right"><a href="/history/<%= e.id %>" class="text-slate-200 underline hover:text-white">View</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>