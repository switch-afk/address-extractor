<h1 class="text-3xl font-semibold tracking-tight text-white">Extract wallet addresses</h1>
<p class="mt-2 max-w-xl text-slate-400">
  Paste a link to an X post. Every reply is checked for EVM, Solana, Bitcoin and Tron addresses, and the list is saved to History.
</p>

<form action="/extract" method="POST" class="mt-8 max-w-2xl" onsubmit="this.querySelector('button').disabled = true">
  <label for="postUrl" class="mb-1 block text-sm text-slate-300">X post link</label>
  <div class="flex flex-col gap-3 sm:flex-row">
    <input id="postUrl" name="postUrl" type="text" inputmode="url" required autofocus
      value="<%= postUrl %>" placeholder="https://x.com/username/status/1234567890"
      class="min-w-0 flex-1 rounded-lg border border-slate-600 bg-indigo-950/60 px-3 py-2 text-white placeholder:text-slate-500 focus:border-slate-300 focus:outline-none">
    <button type="submit" class="rounded-lg bg-slate-100 px-5 py-2 font-medium text-indigo-950 hover:bg-white disabled:opacity-60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-200">
      Extract
    </button>
  </div>
  <% if (error) { %>
    <p class="mt-3 text-sm text-rose-300" role="alert"><%= error %></p>
  <% } %>
</form>

<% if (runningId) { %>
  <p class="mt-6 text-sm text-amber-200">
    An extraction is running. <a href="/history/<%= runningId %>" class="underline hover:text-white">View progress</a>
  </p>
<% } %>